# ==========================================================
# Shopee - API Aberta de Afiliados
# Pegue em: https://affiliate.shopee.com.br > Central de Ferramentas > API Aberta
# ==========================================================
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# ==========================================================
# Mercado Livre - link de afiliado
# O Mercado Livre nao tem API oficial de afiliados. Gere UM link
# manualmente no Portal de Afiliados (afiliados.mercadolivre.com.br),
# cole a URL completa gerada aqui, e o bot extrai sozinho o pedaco
# que identifica sua conta. Exemplo do que colar: a URL inteira que
# o portal te deu depois de "Gerar link" para qualquer produto.
# ==========================================================
ML_SAMPLE_AFFILIATE_LINK=

# ==========================================================
# Mercado Livre - acesso para BUSCAR produtos (obrigatorio - a busca
# de produtos exige login de app, e' diferente do link de afiliado
# acima). Crie um app gratis em:
# https://developers.mercadolivre.com.br/apps/new
# Preencha as 3 linhas abaixo e depois rode "npm run setup-mercadolivre"
# (o REFRESH_TOKEN e preenchido sozinho por esse script).
# ==========================================================
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_REFRESH_TOKEN=

# ==========================================================
# Mercado Livre - gerar link OFICIAL "meli.la" (leitor de grupos de origem)
# "sim" (padrao) = abre um navegador (Chrome, via Playwright) logado na sua
# conta e clica no botao "Compartilhar" de verdade pra cada produto achado
# nos grupos - certeza de comissao, mas mais lento (uns 5-10s por link) e
# abre uma janela visivel. Precisa rodar "npm install" e depois
# "npx playwright install chromium" uma vez antes de usar.
# "nao" = usa so o metodo alternativo (link do produto + matt_word/matt_tool
# direto na URL, sem navegador) - mais rapido, mas sem 100% de certeza.
ML_USAR_NAVEGADOR=sim

# ==========================================================
# Amazon - Programa de Associados / Creators API
# Gere em: Central de Associados > Ferramentas > Creators API
# ATENCAO: exige minimo de 10 vendas qualificadas nos ultimos 30 dias
# para funcionar. Se nao tiver, o bot pula a Amazon e avisa no log,
# sem travar as outras fontes.
#
# AMAZON_ASSOCIATE_TAG sozinho (sem as credenciais da Creators API)
# ja e suficiente para usar "npm run link-amazon" - uma ferramenta manual
# pra montar mensagens da Amazon enquanto voce nao bate as 10 vendas.
# ==========================================================
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br
# So mexa nas duas linhas abaixo se o painel da Amazon mostrar um endereco
# diferente do padrao (a API da Amazon e nova e pode mudar).
AMAZON_CREATORS_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_CREATORS_API_BASE=https://api.amazon.com

# ==========================================================
# WhatsApp - preenchido depois de rodar "npm run setup-whatsapp"
# e escolher o(s) grupo(s) na lista que o script mostra. Pode escolher
# varios de uma vez (o bot posta a mesma oferta em todos).
# ==========================================================
WHATSAPP_GROUP_JIDS=

# ==========================================================
# Comportamento do bot
# ATENCAO: quanto menor o intervalo e maior o volume, maior tambem o risco
# de o WhatsApp marcar o numero como suspeito de automacao. Ajuste com
# moderacao.
# ==========================================================
MIN_DISCOUNT_PERCENT=20
DEDUPE_WINDOW_DAYS=30
POLL_INTERVAL_MINUTES=15
POSTS_PER_CYCLE_PER_SOURCE=3
DELAY_BETWEEN_POSTS_SECONDS=10

# ==========================================================
# Telegram - canal de destino das promocoes. Automacao OFICIAL (Bot API),
# sem risco de suspensao - diferente do WhatsApp, onde qualquer bot usa
# biblioteca nao-oficial e pode derrubar seu numero.
# Como pegar o token:
#   1. No Telegram, procure por @BotFather e mande /newbot
#   2. Escolha nome e @usuario pro bot
#   3. Copie o token que ele responder (tipo 123456789:AAF...)
#   4. No seu canal: Administradores > Adicionar > escolha o bot, com a
#      permissao "Publicar mensagens" ligada (sem isso da "chat not found")
#   5. Rode "npm run testar-telegram" pra confirmar que esta tudo certo
# ==========================================================
TELEGRAM_BOT_TOKEN=
# Aceita "@meucanal", "meucanal" ou "t.me/meucanal".
TELEGRAM_CANAL=
# Pra onde vao as promocoes achadas nos grupos de origem:
#   telegram (padrao) | whatsapp | ambos
DESTINO_POSTAGEM=telegram

# ==========================================================
# Extensao do navegador (extension/) - porta do servidor local que recebe
# as ofertas que voce manda pela extensao. So mude se a porta 4545 estiver
# ocupada por outro programa no seu PC.
# ==========================================================
EXTENSION_SERVER_PORT=4545

# ==========================================================
# Leitor de grupos de origem (src/groupReader.js, roda junto com "npm start")
# - fica escutando os grupos de origem em tempo real (sem abrir/fechar chat,
# sem navegador) e manda os links achados direto pro grupo de destino
# (WHATSAPP_GROUP_JIDS acima), trocados pelo seu link de afiliado. Reaproveita
# AMAZON_ASSOCIATE_TAG e ML_SAMPLE_AFFILIATE_LINK definidos mais acima.
#
# Essas variaveis tem o prefixo "PY_" porque foram criadas originalmente pro
# script Python/Selenium antigo (leitor_grupos.py, descontinuado) - o
# groupReader.js le as mesmas, sem precisar preencher nada de novo. Se
# preferir, pode usar os nomes sem "PY_" (GRUPOS_ORIGEM, MEU_NUMERO,
# APROVACAO_MANUAL, DELAY_ENTRE_POSTS_SEGUNDOS_ORIGEM) - qualquer um funciona.
# ==========================================================
# Nomes EXATOS dos grupos de origem (separados por virgula), como aparecem
# no WhatsApp. Ex: PY_GRUPOS_ORIGEM=Ofertas SP,Promos Brasil
PY_GRUPOS_ORIGEM=
# Seu numero com DDI+DDD, so numeros (ex: 5511999999999) - so usado se
# PY_APROVACAO_MANUAL=sim (pra onde o bot manda os links esperando aprovacao).
PY_MEU_NUMERO=
# "sim" = todo link achado espera sua aprovacao no privado antes de ir pro
# grupo. "nao" (padrao recomendado) = posta direto no grupo de destino sempre
# que conseguir montar um link de afiliado (Amazon/ML/Shopee) - sem link de
# afiliado ainda cai na aprovacao manual.
PY_APROVACAO_MANUAL=nao
# Pausa (segundos) entre posts consecutivos no grupo de destino, quando varios
# links sao achados em sequencia.
PY_DELAY_ENTRE_POSTS_SEGUNDOS=10
